  "voice_agent": {
    "mode": "outbound",
    "voice_style": "friendly_professional",
    "max_response_sentences": 3,
    "max_response_duration_seconds": 25,
    "allow_followup_questions": true,
    "allow_context_switch": true,
    "allow_interruptions": true,
    "always_return_to_flow": true
  },

  "conversation": {
    "goal": "Qualify prospective students, answer admission-related queries, and convert interested candidates into counselling or campus visits.",
    "primary_cta": [
      "Book Counselling",
      "Book Campus Visit",
      "Share Brochure",
      "Collect WhatsApp Number"
    ]
  },

  "state_to_script_key": {
    "CALL_CONNECTED": "outbound_intro",
    "QUALIFICATION_Q1": "qualification_question_1",
    "PROGRAM_OVERVIEW": "program_overview_intro",
    "PROGRAM_SELECTION": "program_selection_question",
    "QUALIFICATION_Q2": "qualification_question_2",
    "PROGRAM_INFO": "program_information",
    "SPECIALIZATION_INFO": "specializations",
    "PLACEMENTS_INFO": "placements",
    "FACILITIES_INFO": "facilities",
    "CAMPUS_INFO": "campus_life",
