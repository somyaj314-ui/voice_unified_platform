    "DOCUMENTS_INFO": "documents_required",
    "FEES_INFO": "fees",
    "VISIT_OPTION": "visit_option",
    "VISIT_SLOT_CAPTURE": "visit_slot_capture",
    "WHATSAPP_READBACK": "whatsapp_readback",
    "WHATSAPP_CONFIRMATION": "whatsapp_confirmation",
    "BROCHURE_CONFIRMATION": "brochure_confirmation",
    "COUNSELLOR_TRANSFER": "connect_counsellor",
    "CLOSING": "closing"
  },

  "llm_fallback": {
    "enabled": true,
    "states": [
      "QUALIFICATION_Q1",
      "QUALIFICATION_Q2",
      "PROGRAM_SELECTION",
      "VISIT_OPTION",
      "PROGRAM_INFO"
    ],
    "max_consecutive_queries": 3,
    "resume_original_flow": true
  },

  "retrieval": {
    "engine": "hybrid",
    "search_order": [
      "intent_match",
      "semantic_similarity",
      "keyword_match"
    ],
    "minimum_confidence": 0.65,
    "top_k": 3,
    "use_related_questions": true,
    "use_keywords": true,
    "use_synonyms": true
  },

  "handoff_policy": {
    "transfer_to_counsellor_for": [
      "Current fee structure",
      "Scholarship details",
      "Education loan assistance",
      "Current admission cutoff",
      "Seat availability",
      "Admission deadline",
      "Application status",
      "Hostel fee",
      "Payment issues",
      "Special approval requests"
    ],
    "transfer_after_failed_attempts": 2
  },

  "voice_rules": {
    "prefer_short_answers": true,
    "avoid_long_lists": true,
    "never_guess_information": true,
    "use_official_information_only": true,
    "confirm_dynamic_information": true,
    "avoid_answering_unverified_questions": true
  },

  "supported_intents": {
