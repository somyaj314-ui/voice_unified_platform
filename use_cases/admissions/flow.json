    "QUALIFICATION_Q1",
    "QUALIFICATION_Q2",
    "VISIT_OPTION",
    "PROGRAM_SELECTION"
  ],
  "states": {
    "CALL_CONNECTED": {
      "script_key": "outbound_intro",
      "transitions": {
        "affirm": "QUALIFICATION_Q1",
        "deny": "CLOSING",
        "default": "QUALIFICATION_Q1"
      }
    },
    "QUALIFICATION_Q1": {
      "script_key": "qualification_question_1",
      "llm_fallback": true,
      "transitions": {
        "grad_completed": "QUALIFICATION_Q2",
        "grad_final_year": "QUALIFICATION_Q2",
        "grad_early": "CLOSING",
        "default": "QUALIFICATION_Q1"
      }
    },
    "QUALIFICATION_Q2": {
      "script_key": "qualification_question_2",
      "llm_fallback": true,
      "transitions": {
        "exam_given": "PROGRAM_OVERVIEW",
        "exam_not_given": "PROGRAM_OVERVIEW",
        "default": "PROGRAM_OVERVIEW"
      }
    },
    "PROGRAM_OVERVIEW": {
      "script_key": "program_overview_intro",
      "transitions": {
        "default": "PROGRAM_SELECTION"
      }
    },
    "PROGRAM_SELECTION": {
      "script_key": "program_selection_question",
      "llm_fallback": true,
      "transitions": {
        "program_mba": "SPECIALIZATION_INFO",
        "program_pgdm": "SPECIALIZATION_INFO",
        "program_both": "SPECIALIZATION_INFO",
        "default": "SPECIALIZATION_INFO"
      }
    },
    "PROGRAM_INFO": {
      "script_key": "program_selection_question",
      "transitions": {
        "default": "SPECIALIZATION_INFO"
      }
    },
    "SPECIALIZATION_INFO": {
      "script_key": "specializations",
      "transitions": {
        "default": "CAMPUS_INFO"
      }
    },
    "CAMPUS_INFO": {
      "script_key": "campus_life",
      "transitions": {
        "default": "CONVERSION"
      }
    },
    "CONVERSION": {
      "script_key": "conversion",
      "transitions": {
        "default": "VISIT_OPTION"
      }
    },
    "VISIT_OPTION": {
      "script_key": "visit_option",
      "llm_fallback": true,
      "transitions": {
        "visit_campus": "VISIT_SLOT_CAPTURE",
        "visit_online": "WHATSAPP_READBACK",
        "default": "WHATSAPP_READBACK"
      }
