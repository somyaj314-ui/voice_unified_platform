    "VISIT_SLOT_CAPTURE": {
      "script_key": "visit_slot_campus",
      "transitions": {
        "default": "WHATSAPP_READBACK"
      }
    },
    "WHATSAPP_READBACK": {
      "script_key": "whatsapp_readback",
      "transitions": {
        "affirm": "WHATSAPP_CONFIRMATION",
        "deny": "CLOSING",
        "default": "WHATSAPP_CONFIRMATION"
      }
    },
    "WHATSAPP_CONFIRMATION": {
      "script_key": "whatsapp_confirmation",
      "transitions": {
        "default": "CLOSING"
      }
    },
    "CLOSING": {
      "script_key": "closing",
      "terminal": true
    }
